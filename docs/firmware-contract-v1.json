{
  "contract": "stem-tape-firmware-contract",
  "contractVersion": "1.0.0",
  "mapVersion": "stem-tape-v1.0.0",
  "target": "Teenage Engineering x Kanye West SP-1 (unreleased) — 4 mono stem lanes",
  "principles": [
    "Audio truth lives in the engine; the control surface emits an ordered command stream, never snapshot diffs.",
    "Playhead is derived from the audio clock through the integrated rate curve, never ticked.",
    "Tempo, beat phase and downbeat detection are automatic, local, deterministic and non-AI.",
    "No user audio leaves the device. Memory figures are MiB (1024^2)."
  ],
  "controls": {
    "buttons": [
      "play",
      "record",
      "function",
      "track-button-1",
      "track-button-2",
      "track-button-3",
      "track-button-4",
      "volume-minus",
      "volume-plus"
    ],
    "rockers": [
      "rocker-fwd",
      "rocker-rev"
    ],
    "faders": [
      "fader-1",
      "fader-2",
      "fader-3",
      "fader-4"
    ]
  },
  "timing": {
    "playTapHoldMs": 450,
    "stemSoloLinkThresholdMs": 700,
    "fxOverlayReleaseMs": 600,
    "fxOverlaySecondPressMs": 120,
    "pairingHoldMs": 2000,
    "exportHoldMs": 900,
    "antiClickFadeMs": 8,
    "cueSeamMs": 12,
    "staleMidiEventMs": 250
  },
  "midi": {
    "identity": "channel:note",
    "accepted": [
      "noteOn",
      "noteOff",
      "allNotesOff (CC 123)"
    ],
    "normalizations": [
      "noteOn velocity 0 -> noteOff",
      "CC 123 -> allNotesOff",
      "clock/aftertouch/program change/sysex dropped"
    ],
    "event": {
      "kind": "noteOn|noteOff|allNotesOff",
      "note": "0..127",
      "velocity": "0..127",
      "channel": "0..15",
      "timestampMs": "performance.now() domain, monotonic",
      "source": "webmidi|coremidi-bridge|test",
      "deviceId": "string",
      "deviceName": "string"
    },
    "cues": {
      "globalLearn": "FUNCTION + hold MIDI key",
      "isolatedLearn": "TRACK n + hold MIDI key",
      "playback": "hold learned key = play cue, release = return",
      "globalPlayback": "parks the song timeline; resumes at the saved frame on release",
      "isolatedPlayback": "replaces one lane; other three lanes and the timeline continue; lane rejoins on release",
      "minCaptureFrames": 1024,
      "invalidation": "contentHash change on the owning lane(s)"
    }
  },
