# Stem Tape Player application Kconfig.
#
# Pulls in the common USB sample options (CONFIG_SAMPLE_USBD_VID/PID/PRODUCT/...)
# consumed by the vendored sample_usbd_init.c device_next bring-up helper, then
# the standard Zephyr Kconfig tree. Mirrors firmware/Kconfig and
# firmware/stemtape/Kconfig exactly -- this file was simply never needed
# before src/main.c became a real derivative of the Tape Looper and started
# using CONFIG_SAMPLE_USBD_* (prj.conf) for its own USB device identity.

source "samples/subsys/usb/common/Kconfig.sample_usbd"

